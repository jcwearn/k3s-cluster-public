#!/usr/bin/env bash
#
# Commit-message hook. Enabled together with pre-commit by
#
#   git config core.hooksPath .githooks
#
# Commit messages are replayed onto the public mirror verbatim -- there is no
# substitution step for them, unlike the manifests. So the same literal-value
# patterns the pre-commit hook applies to files apply here to the message.
#
set -euo pipefail

msg="$1"
patterns=(
  '\b10\.(25[0-3]|2[0-4][0-9]|1?[0-9]?[0-9])\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b192\.168\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b[a-z0-9-]+\.ts\.net\b'
  '\b[a-f0-9]{32}\.r2\.cloudflarestorage\.com\b'
)
# Not private: the CI placeholder values, and the k3s pod/service CIDRs
# (10.42/16 and 10.43/16 are the k3s defaults, not this LAN).
allow='10\.255\.25[45]\.|10\.4[23]\.|example[a-z0-9-]*\.ts\.net|example\.r2\.cloudflarestorage\.com'
fail=0
# Comment lines are stripped by git before the message is stored.
body=$(grep -v '^#' "$msg" || true)
for p in "${patterns[@]}"; do
  hit=$(printf '%s\n' "$body" | grep -nE "$p" | grep -vE "$allow" | head -3 || true)
  if [ -n "$hit" ]; then
    printf 'commit-msg: literal private value in the message (it is published verbatim):\n' >&2
    printf '%s\n' "$hit" | sed 's/^/    /' >&2
    fail=1
  fi
done
root="$(git rev-parse --show-toplevel)"
if [ -f "$root/.publicgate-local" ]; then
  while read -r needle; do
    [ -n "$needle" ] || continue
    if printf '%s\n' "$body" | grep -qF -- "$needle"; then
      printf 'commit-msg: a value from .publicgate-local is in the message\n' >&2
      fail=1
    fi
  done < "$root/.publicgate-local"
fi
if [ "$fail" -ne 0 ]; then
  printf 'commit-msg: refusing the commit (git commit --no-verify to override)\n' >&2
  exit 1
fi
