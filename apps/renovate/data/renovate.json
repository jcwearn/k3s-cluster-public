{
    "repositories": [
        "jcwearn/ansible-runner",
        "jcwearn/anupamaandjackson",
        "jcwearn/borderline",
        "jcwearn/cf-worker-email",
        "jcwearn/cloudflare-infra",
        "jcwearn/dotfiles-coder",
        "jcwearn/hivemind",
        "jcwearn/homeassistant-config",
        "jcwearn/jackson-wearn",
        "jcwearn/k3s-cluster",
        "jcwearn/priceatronic2",
        "jcwearn/resume",
        "jcwearn/truenas-infra",
        "jcwearn/udm-pro",
        "jcwearn/withjoy-exporter",
        "jcwearn/workflows",
        "jcwearn/world-clock"
    ],
    "prHourlyLimit": 0,
    "gitTimeout": 600000,
    "autodiscover": false,
    "platform": "github",
    "onboardingConfig": {
        "$schema": "https://docs.renovatebot.com/renovate-schema.json",
        "extends": [
            "local>jcwearn/renovate-config"
        ]
    },
    "reviewers": [
        "jcwearn"
    ],
    "addLabels": [
        "dependencies"
    ],
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ],
            "matchPackageNames": [
                "*"
            ],
            "groupName": "all non-major dependencies",
            "groupSlug": "all-non-major-dependencies",
            "automerge": true,
            "autoApprove": true,
            "assignAutomerge": true
        },
        {
            "matchRepositories": [
                "jcwearn/cloudflare-infra",
                "jcwearn/truenas-infra"
            ],
            "automerge": false,
            "description": "Merging to main runs tofu apply against live infrastructure, and neither repo has branch protection. Read the plan comment, then merge by hand."
        }
    ],
    "vulnerabilityAlerts": {
        "enabled": true,
        "labels": [
            "security"
        ],
        "reviewers": [
            "jcwearn"
        ]
    },
    "dependencyDashboard": true,
    "osvVulnerabilityAlerts": true,
    "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
    "hostRules": [
        {
            "matchHost": "api.github.com",
            "concurrentRequestLimit": 1,
            "maxRequestsPerSecond": 8
        }
    ],
    "customEnvVariables": {
        "GOCACHE": "/tmp/renovate/go-build",
        "GOMODCACHE": "/tmp/renovate/go-mod",
        "GOBIN": "/tmp/renovate/go-bin",
        "GOPATH": "/tmp/renovate/go",
        "UV_CACHE_DIR": "/tmp/renovate/uv",
        "UV_PYTHON_INSTALL_DIR": "/tmp/renovate/uv-python",
        "UV_TOOL_DIR": "/tmp/renovate/uv-tool",
        "UV_TOOL_BIN_DIR": "/tmp/renovate/uv-tool-bin",
        "NPM_CONFIG_CACHE": "/tmp/renovate/npm",
        "YARN_CACHE_FOLDER": "/tmp/renovate/yarn",
        "YARN_GLOBAL_FOLDER": "/tmp/renovate/berry",
        "npm_config_store": "/tmp/renovate/pnpm",
        "npm_config_cache_dir": "/tmp/renovate/pnpm/cache",
        "npm_config_store_dir": "/tmp/renovate/pnpm/store",
        "pnpm_config_cache_dir": "/tmp/renovate/pnpm/cache",
        "pnpm_config_store_dir": "/tmp/renovate/pnpm/store"
    },
    "binarySource": "global",
    "timezone": "America/New_York",
    "schedule": [
        "* 0-7 * * 0,5,6"
    ]
}